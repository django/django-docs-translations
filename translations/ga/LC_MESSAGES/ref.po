msgstr "``athraithe_foirm.html``"

msgid "``change_form_object_tools.html``"
msgstr "``athraithe_foirm_object_tools.html``"

msgid "``change_list.html``"
msgstr "``liosta_athraithe.html``"

msgid "``change_list_object_tools.html``"
msgstr "``athraithe_liosta_object_tools.html``"

