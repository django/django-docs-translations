msgstr ":lookup: `istartswith`"

msgid "="
msgstr "="

msgid ":lookup:`iexact`"
msgstr ":lookup: `iexact`"

msgid "@"
msgstr "@"

msgid ":lookup:`search`"
msgstr ":lookup: `cuardach`"

