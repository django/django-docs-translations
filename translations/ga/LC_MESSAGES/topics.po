msgstr ""
"Éilíonn gach samhail réimse amháin go díreach: attr: `primary_key=True "
"<Field.primary_key>`(dearbhaithe go sainráite nó cuireadh leis go "
"huathoibríoch)."

msgid "Verbose field names"
msgstr "Ainmneacha réimse Verbose"

msgid ""
"Each field type, except "
"for :class:`~django.db.models.ForeignKey`, :class:`~django.db.models.ManyToManyField` "
