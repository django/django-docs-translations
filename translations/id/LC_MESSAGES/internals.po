msgstr ""
"Dukungan untuk melewatkan argumen penempatan pada ``Signer`` dan "
"``TimestampSigner`` akan dihapus."

msgid ""
"The ``DEFAULT_FILE_STORAGE`` and ``STATICFILES_STORAGE`` settings will be "
"removed."
msgstr ""
"Pengaturan ``DEFAULT_FILE_STORAGE`` and ``STATICFILES_STORAGE`` akan dihapus."

msgid ""
"The ``django.core.files.storage.get_storage_class()`` function will be "
"removed."
msgstr "Fungsi ``django.core.files.storage.get_storage_class()`` akan dihapus."

msgid "5.0"
msgstr "5.0"

msgid ""
"See the :ref:`Django 4.0 release notes <deprecated-features-4.0>` for more "
"details on these changes."
msgstr ""
"Lihat :ref:`Django 4.0 release notes <deprecated-features-4.0>` untuk "
