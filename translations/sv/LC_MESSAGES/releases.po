msgstr ""
"Django 4.1.11 åtgärdar ett säkerhetsproblem med allvarlighetsgrad "
"\"måttlig\" i 4.1.10."

msgid "Django 4.1.12 release notes"
msgstr "Django 4.1.12 release notes"

msgid ""
"Django 4.1.12 fixes a security issue with severity \"moderate\" in 4.1.11."
msgstr ""
"Django 4.1.12 åtgärdar ett säkerhetsproblem med allvarlighetsgrad "
"\"måttlig\" i 4.1.11."

