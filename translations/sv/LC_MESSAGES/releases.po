msgstr ""
"Åtgärdat felmeddelandet \"Korrigera felen nedan\" när du redigerar ett "
"objekt i admin om användaren endast har behörigheten \"view\" på inlines (:"
"ticket:`29930`)."

msgid "Django 2.1.5 release notes"
msgstr "Django 2.1.5 release notes"

msgid "Django 2.1.5 fixes a security issue and several bugs in 2.1.4."
msgstr "Django 2.1.5 åtgärdar ett säkerhetsproblem och flera buggar i 2.1.4."

msgid "Fixed compatibility with mysqlclient 1.3.14 (:ticket:`30013`)."
msgstr "Korrigerad kompatibilitet med mysqlclient 1.3.14 (:ticket:`30013`)."

msgid ""
"Fixed a regression in Django 2.1.4 (which enabled keep-alive connections) "
"where request body data isn't properly consumed for such connections (:"
