msgstr "``django.shortcuts.render_to_response()``"

msgid "``django.template.loader.render_to_string()``"
msgstr "``django.template.loader.render_to_string()``"

msgid "The ``dirs`` parameter for the following functions will be removed:"
msgstr "Parametern ``dirs`` för följande funktioner kommer att tas bort:"

