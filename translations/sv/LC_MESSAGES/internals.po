msgstr ""
"Argumentet ``is_admin_site`` till "
"``django.contrib.auth.views.password_reset()`` kommer att tas bort."

msgid "``django.db.models.field.subclassing.SubfieldBase`` will be removed."
msgstr ""
"``django.db.models.field.subclassing.SubfieldBase`` kommer att tas bort."

msgid ""
"``django.utils.checksums`` will be removed; its functionality is included in "
