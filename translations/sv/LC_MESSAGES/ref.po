msgstr ""
"**models.E030**: indexnamnet ``<index>`` är inte unikt bland modeller: "
"``<model list>``."

msgid ""
"**models.E031**: constraint name ``<constraint>`` is not unique for model "
"``<model>``."
msgstr ""
"**models.E031**: begränsningsnamnet ``<constraint>`` är inte unikt för "
"modellen ``<model>``."

msgid ""
"**models.E032**: constraint name ``<constraint>`` is not unique among "
"models: ``<model list>``."
msgstr ""
"**models.E032**: begränsningsnamnet ``<constraint>`` är inte unikt bland "
"modeller: ``<model list>``."

msgid ""
"**models.E033**: The index name ``<index>`` cannot start with an underscore "
"or a number."
msgstr ""
"**models.E033**: Indexnamnet ``<index>`` kan inte börja med ett understreck "
"eller en siffra."

msgid ""
"**models.E034**: The index name ``<index>`` cannot be longer than "
"``<max_length>`` characters."
msgstr ""
"**modeller.E034**: Indexnamnet ``<index>`` kan inte vara längre än "
"``<max_length>`` tecken."

msgid ""
"**models.W035**: ``db_table`` ``<db_table>`` is used by multiple models: "
"``<model list>``."
msgstr ""
"**modeller.W035**: ``db_table`` ``<db_table>`` används av flera modeller: "
"``<model list>``."

msgid ""
"**models.W036**: ``<database>`` does not support unique constraints with "
