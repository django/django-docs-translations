msgstr ""
"Särskilt användbart är att ange 0 (noll) som argument, vilket gör att "
"floaten avrundas till närmaste heltal."

msgid "``{{ value|floatformat:\"0\" }}``"
msgstr "``{{ value|floatformat:\"0\" }}``"

msgid "``39.56000``"
msgstr "``39.56000``"

msgid "``40``"
msgstr "``40``"

