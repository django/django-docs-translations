msgstr ""
"**models.W036**: ``<database>`` stöder inte unika begränsningar med villkor."

msgid ""
"**models.W037**: ``<database>`` does not support indexes with conditions."
msgstr "**models.W037**: ``<database>`` stöder inte index med villkor."

msgid ""
"**models.W038**: ``<database>`` does not support deferrable unique "
"constraints."
msgstr ""
"**models.W038**: ``<database>`` stöder inte deferrable unique constraints."

msgid ""
"**models.W039**: ``<database>`` does not support unique constraints with non-"
"key columns."
msgstr ""
"**models.W039**: ``<database>`` stöder inte unika begränsningar med icke-"
"nyckelkolumner."

msgid ""
"**models.W040**: ``<database>`` does not support indexes with non-key "
"columns."
msgstr ""
"**models.W040**: ``<database>`` stöder inte index med kolumner som inte är "
"nycklar."

msgid ""
"**models.E041**: ``constraints`` refers to the joined field ``<field name>``."
msgstr ""
"**models.E041**: ``constraints`` hänvisar till det länkade fältet ``<field "
"name>``."

msgid ""
"**models.E042**: ``<field name>`` cannot be included in the composite "
