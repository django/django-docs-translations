msgstr ""
"**Modeller.E026**: Modellen kan inte ha mer än ett fält med "
"``primary_key=True``."

msgid "**models.W027**: ``<database>`` does not support check constraints."
msgstr "**models.W027**: ``<database>`` stöder inte kontrollbegränsningar."

msgid ""
"**models.E028**: ``db_table`` ``<db_table>`` is used by multiple models: "
"``<model list>``."
msgstr ""
"**modeller.E028**: ``db_table`` ``<db_table>`` används av flera modeller: "
"``<model list>``."

msgid ""
"**models.E029**: index name ``<index>`` is not unique for model ``<model>``."
msgstr ""
"**models.E029**: indexnamnet ``<index>`` är inte unikt för modellen "
"``<model>``."

msgid ""
"**models.E030**: index name ``<index>`` is not unique among models: ``<model "
